# Copy this file to .env.local for local development:
#   cp .env.example .env.local          (macOS / Linux)
#   Copy-Item .env.example .env.local   (Windows PowerShell)
#
# Both variables are read at build time by Vite. Restart the dev server after
# changing them -- Vite only reads env files on startup.

# InTravWeb backend: powers offers and lead submission on the main site.
VITE_INTRAVWEB_API_BASE=https://intravweb.onrender.com

# Nepal portal backend: auth, live cities/hotels/packages/pricing, and
# bookings for the B2C, B2B and Admin portals at /nepal.
# Without this the portal falls back to bundled seed data, so prices and
# packages will not match the live database.
VITE_NEPAL_API_BASE=https://tripguru-nepal-api.onrender.com
