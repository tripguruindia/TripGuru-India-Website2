# Turso (libSQL) database. From the Turso dashboard: Databases > your db > Connect.
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="paste the database token here (Create Token > Read & Write)"

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS="https://tripguruindia.com,https://www.tripguruindia.com,http://localhost:5173"

PORT=4000
