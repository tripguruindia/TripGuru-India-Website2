# Postgres connection string (Render provides this automatically when the
# database is linked to the web service as an env var group / direct link).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS="https://tripguruindia.com,https://www.tripguruindia.com,http://localhost:5173"

PORT=4000
