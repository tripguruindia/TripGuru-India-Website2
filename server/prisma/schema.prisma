generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Flat lookup list. Kept as its own table (not JSONB) because the admin
// UI lists/adds/deletes cities individually.
model City {
  id   Int    @id @default(autoincrement())
  name String @unique

  @@map("cities")
}

// rates is the 5x3 {single,double,extra_adult,cwb,cnb} x {CP,MAP,AP} matrix,
// consumed as one object by the pricing engine and the nested rate-grid
// editor in the admin UI -- kept as JSONB rather than normalized.
model Hotel {
  id          String  @id
  name        String
  city        String
  category    String
  description String?
  rates       Json

  @@map("hotels")
}

// routeRates is a dynamic {routeKey: number} map keyed by Route.key.
model Vehicle {
  id                   String  @id
  name                 String
  description          String?
  capacity             Int?
  dailySightseeingRate Decimal? @map("daily_sightseeing_rate") @db.Decimal(12, 2)
  routeRates           Json     @map("route_rates")

  @@map("vehicles")
}

model Route {
  key         String  @id
  name        String
  description String?

  @@map("routes")
}

model Activity {
  id          String  @id
  name        String
  city        String
  description String?
  priceAdult  Decimal? @map("price_adult") @db.Decimal(12, 2)
  priceChild  Decimal? @map("price_child") @db.Decimal(12, 2)

  @@map("activities")
}

// cities/days are kept as JSONB: `days` is a deeply nested itinerary array
// (city, hotelId, transfer_route, activity_ids[], meals, ...) that the
// pricing engine and package day-editor read/write as one blob. There is
// no DB-level referential integrity for the ids embedded inside `days` --
// the admin API validates those references in application code.
model Package {
  id                    String   @id
  name                  String
  description           String?
  durationNights        Int?     @map("duration_nights")
  defaultHotelCategory  String?  @map("default_hotel_category")
  defaultVehicleId      String?  @map("default_vehicle_id")
  startingPriceOverride Decimal? @map("starting_price_override") @db.Decimal(12, 2)
  cities                Json
  days                  Json

  @@map("packages")
}

// Singleton row (id is always 1).
model Settings {
  id                    Int      @id @default(1)
  markupPercent         Decimal  @default(15) @map("markup_percent") @db.Decimal(6, 2)
  b2cMarkupPercent      Decimal  @default(15) @map("b2c_markup_percent") @db.Decimal(6, 2)
  b2bMarkupPercent      Decimal  @default(10) @map("b2b_markup_percent") @db.Decimal(6, 2)
  b2bAdminMarginPercent Decimal  @default(10) @map("b2b_admin_margin_percent") @db.Decimal(6, 2)
  taxPercent            Decimal  @default(13) @map("tax_percent") @db.Decimal(6, 2)
  exchangeRate          Decimal? @map("exchange_rate") @db.Decimal(12, 4)
  popupPosterUrl        String?  @map("popup_poster_url")
  popupPosterActive     Boolean  @default(false) @map("popup_poster_active")

  @@map("settings")
}

// Read-only via the admin API in Phase 0 (write path lands with B2C/B2B
// wiring). passengers/itinerary/rooms/b2bWhiteLabel are write-once blobs
// produced by the client-side quote wizard -- kept as JSONB.
model Booking {
  id                    String   @id
  clientName            String   @map("client_name")
  email                 String?
  phone                 String?
  travelDate            String?  @map("travel_date")
  adults                Int?     @default(0)
  cwb                   Int?     @default(0)
  cnb                   Int?     @default(0)
  totalPrice            Decimal? @map("total_price") @db.Decimal(12, 2)
  packageName           String?  @map("package_name")
  status                String   @default("Confirmed")
  createdAt             DateTime @default(now()) @map("created_at")
  itinerarySummary      String?  @map("itinerary_summary")
  type                  String
  // Real FK to users.id once bookings are created server-side (Phase 2).
  // The legacy client hardcodes a fake agent id today -- see server/README.md.
  agentId               String?  @map("agent_id")
  agentCommission       Decimal? @map("agent_commission") @db.Decimal(12, 2)
  vehicleId             String?  @map("vehicle_id")
  hotelCategory         String?  @map("hotel_category")
  startCity             String?  @map("start_city")
  endCity               String?  @map("end_city")
  notes                 String?
  markupPercent         Decimal? @map("markup_percent") @db.Decimal(6, 2)
  b2bAdminMarginPercent Decimal? @map("b2b_admin_margin_percent") @db.Decimal(6, 2)
  passengers            Json?
  itinerary             Json?
  rooms                 Json?
  b2bWhiteLabel         Json?    @map("b2b_white_label")

  @@map("bookings")
}

model Lead {
  id          String   @id
  name        String
  email       String?
  countryCode String?  @map("country_code")
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model User {
  id            String   @id
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          String
  fullName      String?  @map("full_name")
  phone         String?
  countryCode   String?  @map("country_code")
  agencyName    String?  @map("agency_name")
  agencyAddress String?  @map("agency_address")
  agencyPhone   String?  @map("agency_phone")
  agencyEmail   String?  @map("agency_email")
  agencyWebsite String?  @map("agency_website")
  walletBalance Decimal  @default(0) @map("wallet_balance") @db.Decimal(12, 2)
  address       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("users")
}
